generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TRAINER
  STABLE_WORKER
}

enum SystemModule {
  SCHEDULE
  STABLES
  VETERINARY
  CASHBOX
  STAFF_PAYROLL
}

enum AccessLevel {
  FULL
  READ_ONLY
  HIDDEN
}

model ClubModuleSettings {
  id        String       @id @default(uuid()) @db.Uuid
  module    SystemModule @unique
  isEnabled Boolean      @default(true)
  updatedAt DateTime     @updatedAt
}

model RoleModulePermission {
  id          String       @id @default(uuid()) @db.Uuid
  role        Role
  module      SystemModule
  accessLevel AccessLevel  @default(HIDDEN)

  @@unique([role, module])
}

enum HorseSex {
  STALLION
  MARE
  GELDING
}

enum StallZone {
  MAIN
  SUMMER
  QUARANTINE
}

enum StallSide {
  LEFT
  RIGHT
}

enum StallStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  QUARANTINE
}

enum HorseOwnerType {
  club
  private
}

enum HorseStatus {
  active
  rest
  sick
  quarantine
}

enum ArenaType {
  indoor_arena
  outdoor_arena
  round_pen
  trail
}

enum MembershipType {
  fixed_lessons
  deposit
  boarding
}

enum MembershipStatus {
  active
  frozen
  expired
  exhausted
}

enum BookingServiceType {
  dressage
  jumping
  walks
  beginners
  photoshoot
  corde
}

enum BookingStatus {
  scheduled
  completed
  no_show
  cancelled_client
  cancelled_club
  penalty_cancellation
}

enum TransactionType {
  purchase
  usage
  penalty_cancellation
  refund
  boarding_charge
  manual_adjustment
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum LessonPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum MembershipOpType {
  DEBIT
  CREDIT
  REFUND
}

enum HealthLogType {
  VACCINATION
  FARRIER
  DEWORMING
  INSPECTION
}

enum PaymentMethod {
  UNSPECIFIED
  CASH
  CARD_TERMINAL
  SBP
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum BoardingContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

enum LeadRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  membershipsSold Membership[] @relation("MembershipSeller")
  staffProfile StaffProfile?
  workShiftsCreated WorkShift[] @relation("ShiftAuthor")
  payrollsCreated PayrollCalculation[] @relation("PayrollAuthor")
  vetRecords VetRecord[]
  expenses Expense[] @relation("ExpenseAuthor")
  cancelledExpenses Expense[] @relation("ExpenseCanceller")
  trainerId    String? @unique @db.Uuid
  trainer      Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  horseChanges BookingHorseChange[]
  cashPayments Payment[]
  cashShifts CashShift[]
  vkUserId     BigInt?  @unique
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  tokenVersion Int      @default(1)
  passwordHash String
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model Service {
  isPerPerson Boolean @default(false)
  memberships Membership[]
  isPublic Boolean @default(true)
  imageUrl String?
  description String?
  role String?
  order Int @default(0)
  payments Payment[]
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  title                   String        @default("")
  maxCapacity             Int           @default(1)
  cancellationWindowHours Int           @default(24)
  allowMembership         Boolean       @default(true)
  durationMinutes         Int
  price                   Decimal       @default(0) @db.Decimal(12, 2)
  lessons                 Lesson[]
  leadRequests            LeadRequest[]
  createdAt               DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(6)
}

model Trainer {
  user User?
  isPublic Boolean @default(true)
  imageUrl String?
  description String?
  role String?
  order Int @default(0)
  fullName        String   @default("")
  telegramId      String?  @unique
  specializations String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  bookings        Booking[]
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @default("")
  phone         String?  @unique
  vkUserId      BigInt?  @unique
  qualification String?
  maxDailyLoad  Int      @default(480)
  baseRate      Decimal  @default(0) @db.Decimal(12, 2)
  lessons       Lesson[]
}

model Horse {
  healthStatus HorseHealthStatus @default(HEALTHY)
  quarantineUntil DateTime? @db.Timestamptz(6)
  vetRecords VetRecord[]
  isPublic Boolean @default(true)
  imageUrl String?
  description String?
  role String?
  order Int @default(0)
  dailyLogs BoardingDailyLog[]
  vetEvents VetEvent[]
  ownerType               HorseOwnerType @default(club)
  ownerId                 String?        @db.Uuid
  owner                   Client?        @relation("HorseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  sex                     HorseSex?
  birthYear               Int?
  stall                   Stall?
  stallNumber             String?
  maxRiderWeight          Int            @default(85)
  maxDailyWorkloadMinutes Int            @default(120)
  requiredRestMinutes     Int            @default(45)
  suitability             String[]       @default([])
  status                  HorseStatus    @default(active)
  lastVetCheckAt          DateTime?      @db.Timestamptz(6)
  nextShoeingDate         DateTime?      @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(6)
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  breed             String?
  riderLevel        String?
  feedingNotes      String?
  isUnavailable     Boolean            @default(false)
  unavailableReason String?
  unavailableFrom   DateTime?          @db.Timestamptz(6)
  unavailableUntil  DateTime?          @db.Timestamptz(6)
  maxDailyMinutes   Int                @default(120)
  minRestMinutes    Int                @default(45)
  bookings          Booking[]
  healthLogs        HorseHealthLog[]
  boardingContracts BoardingContract[]

  @@index([ownerId])
  @@index([status])
}

enum ClientType {
  REGULAR
  ONE_TIME
}

model Client {
  clientType ClientType @default(REGULAR)
  riderLevel String?
  boardingBalance Decimal @default(0) @db.Decimal(14, 2)
  boardingDailyLogs BoardingDailyLog[]
  weightKg          Decimal?           @db.Decimal(5, 2)
  ownedHorses       Horse[]            @relation("HorseOwner")
  transactions      LedgerTransaction[]
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @default("")
  firstName         String             @default("")
  lastName          String             @default("")
  isRider           Boolean            @default(true)
  isPayer           Boolean            @default(false)
  preferences       String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  phone             String?            @unique
  vkUserId          BigInt?            @unique
  email             String?
  medicalNotes      String?
  bookings          Booking[]
  leadRequests      LeadRequest[]
  memberships       Membership[]
  boardingContracts BoardingContract[]
  payments          Payment[]
  isLead            Boolean            @default(false)
}

model LeadRequest {
  id             String            @id @default(uuid()) @db.Uuid
  firstName      String
  phone          String
  email          String?
  preferences    String?
  consentVersion String?
  consentedAt    DateTime?         @db.Timestamptz(6)
  consentSource  String?
  status         LeadRequestStatus @default(PENDING)
  clientId       String?           @db.Uuid
  serviceId      String?           @db.Uuid
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service        Service?          @relation(fields: [serviceId], references: [id])
  processedAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([phone, status])
  @@index([serviceId])
}

model VkConsent {
  vkUserId       BigInt   @id
  consentVersion String
  consentedAt    DateTime @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

model Lesson {
  participantsCount Int? @default(1)
  pricePerPerson Decimal? @db.Decimal(12, 2)
  cost Decimal? @default(0) @db.Decimal(12, 2)
  paymentStatus LessonPaymentStatus @default(UNPAID)
  prepaymentAmount Decimal? @default(0) @db.Decimal(12, 2)
  prepaymentMethod PaymentMethod?
  finalPaymentAmount Decimal? @default(0) @db.Decimal(12, 2)
  finalPaymentMethod PaymentMethod?
  id         String         @id @default(uuid()) @db.Uuid
  trainerId  String         @db.Uuid
  serviceId  String         @db.Uuid
  arenaId    String?        @db.Uuid
  startTime  DateTime       @db.Timestamptz(6)
  endTime    DateTime       @db.Timestamptz(6)
  status     LessonStatus   @default(SCHEDULED)
  trainer    Trainer        @relation(fields: [trainerId], references: [id])
  service    Service        @relation(fields: [serviceId], references: [id])
  arena      Arena?         @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  bookings   Booking[]
  operations MembershipOp[]
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  @@index([trainerId, startTime, endTime])
  @@index([arenaId, startTime, endTime])
}

model Membership {
  serviceId String? @db.Uuid
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceTitle String?
  pricePerLesson Decimal? @db.Decimal(12, 2)
  totalPrice Decimal? @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  saleRequestId String? @unique @db.Uuid
  saleFingerprint String?
  soldById String? @db.Uuid
  soldBy User? @relation("MembershipSeller", fields: [soldById], references: [id], onDelete: Restrict)
  cashboxPosted Boolean @default(false)
  @@index([serviceId])

  type               MembershipType   @default(fixed_lessons)
  title              String           @default("")
  initialUnits       Decimal          @default(0) @db.Decimal(14, 2)
  remainingUnits     Decimal          @default(0) @db.Decimal(14, 2)
  validFrom          DateTime         @default(now()) @db.Timestamptz(6)
  validTo            DateTime         @default(now()) @db.Timestamptz(6)
  allowedDisciplines String[]         @default([])
  status             MembershipStatus @default(active)
  transactions       LedgerTransaction[]
  legacyUnassigned   Boolean          @default(false)
  id              String         @id @default(uuid()) @db.Uuid
  totalLessons    Int            @default(0)
  remainedLessons Int            @default(0)
  validUntil      DateTime       @default(now()) @db.Timestamptz(6)
  clientId        String?        @db.Uuid
  client          Client?        @relation(fields: [clientId], references: [id])
  pricingPlanId   String?        @db.Uuid
  pricingPlan     PricingPlan?   @relation(fields: [pricingPlanId], references: [id])
  bookings        Booking[]
  operations      MembershipOp[]
  payments        Payment[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@index([pricingPlanId])
  @@index([clientId, status, validTo])
}

model PricingPlan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  totalLessons Int
  validDays    Int
  price        Decimal      @default(0) @db.Decimal(12, 2)
  memberships  Membership[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
}

model Booking {
  prepaymentAmount Decimal @default(0) @db.Decimal(12, 2)
  prepaymentMethod PaymentMethod?
  finalPaymentAmount Decimal @default(0) @db.Decimal(12, 2)
  finalPaymentMethod PaymentMethod?
  horseChanges BookingHorseChange[]
  isPaid Boolean @default(false)
  trainerId           String              @db.Uuid
  arenaId             String?             @db.Uuid
  startTime           DateTime            @db.Timestamptz(6)
  endTime             DateTime            @db.Timestamptz(6)
  serviceType         BookingServiceType?
  status              BookingStatus       @default(scheduled)
  costAmount          Decimal             @default(0) @db.Decimal(14, 2)
  cancellationReason  String?
  trainer             Trainer             @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  arena               Arena?              @relation(fields: [arenaId], references: [id], onDelete: Restrict)
  transactions        LedgerTransaction[]
  legacyLessonBinding Boolean             @default(false)
  id               String            @id @default(uuid()) @db.Uuid
  lessonId         String?           @db.Uuid
  clientId         String            @db.Uuid
  horseId          String?           @db.Uuid
  membershipId     String?           @db.Uuid
  attended         Boolean           @default(false)
  horseChangeReason String?
  attendanceStatus BookingAttendance @default(PENDING)
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  client           Client            @relation(fields: [clientId], references: [id])
  horse            Horse?            @relation(fields: [horseId], references: [id], onDelete: Restrict)
  membership       Membership?       @relation(fields: [membershipId], references: [id])
  payments         Payment[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  @@index([lessonId])
  @@index([clientId])
  @@index([horseId])
  @@index([membershipId])
  @@index([startTime, endTime])
  @@index([trainerId, status, startTime, endTime])
  @@index([horseId, status, startTime, endTime])
  @@index([arenaId, status, startTime, endTime])
}

model BookingHorseChange {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @db.Uuid
  actorUserId String @db.Uuid
  oldHorseId  String? @db.Uuid
  newHorseId  String @db.Uuid
  reason      String?
  changedAt   DateTime @default(now()) @db.Timestamptz(6)
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor       User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([bookingId, changedAt])
}

model RoleAccess {
  role              Role @id
  horseReplaceOwn   Boolean @default(false)
  horseReplaceAny   Boolean @default(false)
  healthRead        Boolean @default(true)
  healthWrite       Boolean @default(false)
  financeRead       Boolean @default(false)
  boardingAccess    Boolean @default(true)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
}

model Arena {
  type              ArenaType @default(indoor_arena)
  maxRidersCapacity Int       @default(6)
  isActive          Boolean   @default(true)
  bookings          Booking[]
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  capacity      Int      @default(6)
  isUnavailable Boolean  @default(false)
  lessons       Lesson[]
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

model LedgerTransaction {
  cashDeskPaymentId String? @unique @db.Uuid
  cashDeskPayment Payment? @relation("CashDeskLedger", fields: [cashDeskPaymentId], references: [id], onDelete: Restrict)
  boardingContractId String? @db.Uuid
  billingMonth String?
  boardingDailyLogId String? @unique @db.Uuid
  sourcePaymentId String? @db.Uuid
  boardingContract BoardingContract? @relation(fields: [boardingContractId], references: [id], onDelete: Restrict)
  boardingDailyLog BoardingDailyLog? @relation(fields: [boardingDailyLogId], references: [id], onDelete: Restrict)
  sourcePayment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  id                   String          @id @default(uuid()) @db.Uuid
  clientId             String          @db.Uuid
  bookingId            String?         @db.Uuid
  membershipId         String?         @db.Uuid
  transactionType      TransactionType
  amount               Decimal         @db.Decimal(14, 2)
  description          String?
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  sourceMembershipOpId String?         @unique @db.Uuid
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  booking              Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  membership           Membership?     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  sourceMembershipOp   MembershipOp?   @relation(fields: [sourceMembershipOpId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([membershipId, createdAt])
  @@index([bookingId, transactionType])
  @@unique([boardingContractId, billingMonth])
  @@index([boardingContractId, createdAt])
}

model HorseHealthLog {
  id         String        @id @default(uuid()) @db.Uuid
  horseId    String        @db.Uuid
  type       HealthLogType
  occurredAt DateTime      @db.Timestamptz(6)
  nextDueAt  DateTime?     @db.Timestamptz(6)
  notes      String?
  horse      Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(6)

  @@index([horseId, occurredAt])
  @@index([type, nextDueAt])
}

model Stall {
  number        String?
  zone          StallZone @default(MAIN)
  side          StallSide @default(LEFT)
  position      Int?
  status        StallStatus @default(AVAILABLE)
  horseId       String? @unique @db.Uuid
  horse         Horse? @relation(fields: [horseId], references: [id], onDelete: Restrict)
  notes         String?

  @@unique([zone, side, position])
  @@unique([zone, number])
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @unique
  description   String?
  isUnavailable Boolean            @default(false)
  contracts     BoardingContract[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
}

model BoardingContract {
  transactions LedgerTransaction[]
  id          String                 @id @default(uuid()) @db.Uuid
  clientId    String?                @db.Uuid
  horseId     String                 @db.Uuid
  stallId     String?                @db.Uuid
  status      BoardingContractStatus @default(DRAFT)
  startsAt    DateTime               @db.Timestamptz(6)
  endsAt      DateTime?              @db.Timestamptz(6)
  monthlyRate Decimal                @default(0) @db.Decimal(12, 2)
  notes       String?
  client      Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  horse       Horse                  @relation(fields: [horseId], references: [id])
  stall       Stall?                 @relation(fields: [stallId], references: [id], onDelete: SetNull)
  payments    Payment[]
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)

  @@index([clientId])
  @@index([horseId, status])
  @@index([stallId, status])
}

model CashShift {
  expenses Expense[]
  id String @id @default(uuid()) @db.Uuid
  cashierId String @db.Uuid
  cashier User @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  openedAt DateTime @default(now()) @db.Timestamptz(6)
  closedAt DateTime? @db.Timestamptz(6)
  startingCash Decimal @default(0) @db.Decimal(12, 2)
  notes String?
  payments Payment[]
  @@index([cashierId, openedAt])
}

enum ExpensePaymentMethod {
  CASH
  CARD
}

enum ExpenseCategory {
  FEED
  BEDDING
  VET_FARRIER
  AMMUNITION
  MAINTENANCE
  SALARY
  OTHER
}

model Expense {
  payroll PayrollCalculation?
  id String @id @default(uuid()) @db.Uuid
  requestId String? @unique @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  paymentMethod ExpensePaymentMethod
  category ExpenseCategory
  description String @db.VarChar(500)
  date DateTime @default(now()) @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdById String @db.Uuid
  createdBy User @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  receiptUrl String?
  shiftId String? @db.Uuid
  shift CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  cancelledAt DateTime? @db.Timestamptz(6)
  cancelledById String? @db.Uuid
  cancelledBy User? @relation("ExpenseCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  @@index([cancelledAt, date])
  @@index([paymentMethod, category, date])
  @@index([createdById, date])
  @@index([shiftId])
}

enum WorkShiftStatus {
  SCHEDULED
  COMPLETED
  ABSENT
  SICK
}

model StaffProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  fullName String
  roleTitle String
  shiftRate Decimal? @db.Decimal(12, 2)
  lessonRate Decimal? @db.Decimal(12, 2)
  groupLessonRate Decimal? @db.Decimal(12, 2)
  lessonPercentage Decimal? @db.Decimal(5, 2)
  isActive Boolean @default(true)
  shifts WorkShift[]
  payrolls PayrollCalculation[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model WorkShift {
  id String @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  startTime String @db.VarChar(5)
  endTime String @db.VarChar(5)
  status WorkShiftStatus @default(SCHEDULED)
  notes String?
  createdById String @db.Uuid
  createdBy User @relation("ShiftAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([staffId, date])
  @@index([date, status])
}

model PayrollCalculation {
  id String @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  shiftsCount Int
  shiftsTotal Decimal @db.Decimal(12, 2)
  lessonsCount Int
  lessonsTotal Decimal @db.Decimal(12, 2)
  bonuses Decimal @default(0) @db.Decimal(12, 2)
  penalties Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  isPaid Boolean @default(false)
  paidAt DateTime? @db.Timestamptz(6)
  expenseId String? @unique @db.Uuid
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdById String @db.Uuid
  createdBy User @relation("PayrollAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([staffId, periodStart, periodEnd])
  @@index([staffId, isPaid, periodStart, periodEnd])
}

model Payment {
  cashDeskTransaction LedgerTransaction? @relation("CashDeskLedger")
  cashGiven Decimal? @db.Decimal(12, 2)
  cashChange Decimal? @db.Decimal(12, 2)
  cashierId String? @db.Uuid
  cashier User? @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  shiftId String? @db.Uuid
  shift CashShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  serviceId String? @db.Uuid
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceType String?
  notes String?
  requestId String? @unique @db.Uuid
  transactions LedgerTransaction[]
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String            @db.Uuid
  bookingId          String?           @db.Uuid
  boardingContractId String?           @db.Uuid
  membershipId       String?           @db.Uuid
  amount             Decimal           @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus     @default(PENDING)
  paidAt             DateTime?         @db.Timestamptz(6)
  description        String?
  client             Client            @relation(fields: [clientId], references: [id])
  booking            Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  boardingContract   BoardingContract? @relation(fields: [boardingContractId], references: [id], onDelete: SetNull)
  membership         Membership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  @@index([clientId, createdAt])
  @@index([bookingId])
  @@index([boardingContractId])
  @@index([status, createdAt])
  @@index([cashierId, paidAt])
  @@index([shiftId])
  @@index([membershipId])
}

enum BookingAttendance {
  PENDING
  ATTENDED
  NO_SHOW
}

model VkLinkCode {
  id        String   @id @default(uuid()) @db.Uuid
  codeHash  String   @unique
  phone     String
  kind      String
  recordId  String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  usedBy    BigInt?
}

model VkNotification {
  attemptCount Int      @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique
  peerId    BigInt
  message   String
  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  @@index([sentAt, nextAttemptAt])
}

model MembershipOp {
  transaction  LedgerTransaction?
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @db.Uuid
  lessonId     String?          @db.Uuid
  type         MembershipOpType
  amount       Int
  reason       String
  membership   Membership       @relation(fields: [membershipId], references: [id])
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  // PostgreSQL допускает несколько строк с lessonId = NULL, но запрещает
  // повтор одного типа операции для конкретной пары абонемент/занятие.
  @@unique([membershipId, lessonId, type])
  @@index([lessonId])
}

model ClubSchedule {
  id            Int      @id @default(1)
  openTime      String   @default("09:00")
  closeTime     String   @default("21:00")
  daysOfWeekOff Int[]    @default([1])
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model BoardingDailyLog {
  id String @id @default(uuid()) @db.Uuid
  horseId String @db.Uuid
  clientId String @db.Uuid
  serviceType String
  cost Decimal @db.Decimal(12, 2)
  performedAt DateTime @default(now()) @db.Timestamptz(6)
  performedBy String?
  notes String?
  requestId String @unique @db.Uuid
  horse Horse @relation(fields: [horseId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transaction LedgerTransaction?

  @@index([horseId, performedAt])
  @@index([clientId, performedAt])
}

enum HorseHealthStatus {
  HEALTHY
  TREATMENT
  QUARANTINE
  RETIRED
}

enum VetRecordType {
  VACCINATION
  DEWORMING
  BLOOD_TEST
  FARRIER
  EXAMINATION
  TREATMENT
  DENTAL
}

model VetRecord {
  id String @id @default(uuid()) @db.Uuid
  horseId String @db.Uuid
  horse Horse @relation(fields: [horseId], references: [id], onDelete: Restrict)
  type VetRecordType
  title String
  performedAt DateTime @db.Timestamptz(6)
  nextDueDate DateTime? @db.Timestamptz(6)
  specialist String
  medication String?
  notes String?
  cost Decimal? @db.Decimal(12, 2)
  documentUrl String?
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([horseId, performedAt])
  @@index([type, performedAt])
  @@index([nextDueDate])
  @@index([createdById])
}

enum VetEventType {
  vaccination
  deworming
  shoeing
  vet_check
  dentist
}

enum VetEventStatus {
  scheduled
  completed
  overdue
}

model VetEvent {
  id String @id @default(uuid()) @db.Uuid
  horseId String @db.Uuid
  type VetEventType
  eventDate DateTime @db.Timestamptz(6)
  nextDueDate DateTime? @db.Timestamptz(6)
  performedBy String?
  notes String?
  status VetEventStatus @default(scheduled)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sourceHealthLogId String? @unique @db.Uuid
  predecessorId String? @unique @db.Uuid
  predecessor VetEvent? @relation("VetFollowup", fields: [predecessorId], references: [id], onDelete: Cascade)
  followup VetEvent? @relation("VetFollowup")
  horse Horse @relation(fields: [horseId], references: [id], onDelete: Restrict)

  @@index([status, eventDate])
  @@index([horseId, eventDate])
}
