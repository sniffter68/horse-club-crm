generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TRAINER
}

enum HorseOwnerType {
  club
  private
}

enum HorseStatus {
  active
  rest
  sick
  quarantine
}

enum ArenaType {
  indoor_arena
  outdoor_arena
  round_pen
  trail
}

enum MembershipType {
  fixed_lessons
  deposit
  boarding
}

enum MembershipStatus {
  active
  frozen
  expired
  exhausted
}

enum BookingServiceType {
  dressage
  jumping
  walks
  beginners
  photoshoot
  corde
}

enum BookingStatus {
  scheduled
  completed
  no_show
  cancelled_client
  cancelled_club
  penalty_cancellation
}

enum TransactionType {
  purchase
  usage
  penalty_cancellation
  refund
  boarding_charge
  manual_adjustment
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum MembershipOpType {
  DEBIT
  CREDIT
  REFUND
}

enum HealthLogType {
  VACCINATION
  FARRIER
  DEWORMING
  INSPECTION
}

enum PaymentMethod {
  UNSPECIFIED
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum BoardingContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

enum LeadRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  vkUserId     BigInt?  @unique
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model Service {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  title                   String        @default("")
  maxCapacity             Int           @default(1)
  cancellationWindowHours Int           @default(24)
  allowMembership         Boolean       @default(true)
  durationMinutes         Int
  price                   Decimal       @default(0) @db.Decimal(12, 2)
  lessons                 Lesson[]
  leadRequests            LeadRequest[]
  createdAt               DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(6)
}

model Trainer {
  fullName        String   @default("")
  telegramId      String?  @unique
  specializations String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  bookings        Booking[]
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @default("")
  phone         String?  @unique
  vkUserId      BigInt?  @unique
  qualification String?
  maxDailyLoad  Int      @default(480)
  baseRate      Decimal  @default(0) @db.Decimal(12, 2)
  lessons       Lesson[]
}

model Horse {
  ownerType               HorseOwnerType @default(club)
  ownerId                 String?        @db.Uuid
  owner                   Client?        @relation("HorseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stallNumber             String?
  maxRiderWeight          Int            @default(85)
  maxDailyWorkloadMinutes Int            @default(120)
  requiredRestMinutes     Int            @default(45)
  suitability             String[]       @default([])
  status                  HorseStatus    @default(active)
  lastVetCheckAt          DateTime?      @db.Timestamptz(6)
  nextShoeingDate         DateTime?      @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(6)
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  breed             String?
  riderLevel        String?
  feedingNotes      String?
  isUnavailable     Boolean            @default(false)
  unavailableReason String?
  unavailableFrom   DateTime?          @db.Timestamptz(6)
  unavailableUntil  DateTime?          @db.Timestamptz(6)
  maxDailyMinutes   Int                @default(120)
  minRestMinutes    Int                @default(45)
  bookings          Booking[]
  healthLogs        HorseHealthLog[]
  boardingContracts BoardingContract[]

  @@index([ownerId])
  @@index([status])
}

model Client {
  weightKg          Decimal?           @db.Decimal(5, 2)
  ownedHorses       Horse[]            @relation("HorseOwner")
  transactions      LedgerTransaction[]
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @default("")
  firstName         String             @default("")
  lastName          String             @default("")
  isRider           Boolean            @default(true)
  isPayer           Boolean            @default(false)
  preferences       String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  phone             String?            @unique
  vkUserId          BigInt?            @unique
  email             String?
  medicalNotes      String?
  bookings          Booking[]
  leadRequests      LeadRequest[]
  memberships       Membership[]
  boardingContracts BoardingContract[]
  payments          Payment[]
  isLead            Boolean            @default(false)
}

model LeadRequest {
  id             String            @id @default(uuid()) @db.Uuid
  firstName      String
  phone          String
  email          String?
  preferences    String?
  consentVersion String?
  consentedAt    DateTime?         @db.Timestamptz(6)
  consentSource  String?
  status         LeadRequestStatus @default(PENDING)
  clientId       String?           @db.Uuid
  serviceId      String?           @db.Uuid
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service        Service?          @relation(fields: [serviceId], references: [id])
  processedAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([phone, status])
  @@index([serviceId])
}

model VkConsent {
  vkUserId       BigInt   @id
  consentVersion String
  consentedAt    DateTime @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

model Lesson {
  id         String         @id @default(uuid()) @db.Uuid
  trainerId  String         @db.Uuid
  serviceId  String         @db.Uuid
  arenaId    String?        @db.Uuid
  startTime  DateTime       @db.Timestamptz(6)
  endTime    DateTime       @db.Timestamptz(6)
  status     LessonStatus   @default(SCHEDULED)
  trainer    Trainer        @relation(fields: [trainerId], references: [id])
  service    Service        @relation(fields: [serviceId], references: [id])
  arena      Arena?         @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  bookings   Booking[]
  operations MembershipOp[]
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  @@index([trainerId, startTime, endTime])
  @@index([arenaId, startTime, endTime])
}

model Membership {
  type               MembershipType   @default(fixed_lessons)
  title              String           @default("")
  initialUnits       Decimal          @default(0) @db.Decimal(14, 2)
  remainingUnits     Decimal          @default(0) @db.Decimal(14, 2)
  validFrom          DateTime         @default(now()) @db.Timestamptz(6)
  validTo            DateTime         @default(now()) @db.Timestamptz(6)
  allowedDisciplines String[]         @default([])
  status             MembershipStatus @default(active)
  transactions       LedgerTransaction[]
  legacyUnassigned   Boolean          @default(false)
  id              String         @id @default(uuid()) @db.Uuid
  totalLessons    Int            @default(0)
  remainedLessons Int            @default(0)
  validUntil      DateTime       @default(now()) @db.Timestamptz(6)
  clientId        String?        @db.Uuid
  client          Client?        @relation(fields: [clientId], references: [id])
  pricingPlanId   String?        @db.Uuid
  pricingPlan     PricingPlan?   @relation(fields: [pricingPlanId], references: [id])
  bookings        Booking[]
  operations      MembershipOp[]
  payments        Payment[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@index([pricingPlanId])
  @@index([clientId, status, validTo])
}

model PricingPlan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  totalLessons Int
  validDays    Int
  price        Decimal      @default(0) @db.Decimal(12, 2)
  memberships  Membership[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
}

model Booking {
  trainerId           String              @db.Uuid
  arenaId             String?             @db.Uuid
  startTime           DateTime            @db.Timestamptz(6)
  endTime             DateTime            @db.Timestamptz(6)
  serviceType         BookingServiceType?
  status              BookingStatus       @default(scheduled)
  costAmount          Decimal             @default(0) @db.Decimal(14, 2)
  cancellationReason  String?
  trainer             Trainer             @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  arena               Arena?              @relation(fields: [arenaId], references: [id], onDelete: Restrict)
  transactions        LedgerTransaction[]
  legacyLessonBinding Boolean             @default(false)
  id               String            @id @default(uuid()) @db.Uuid
  lessonId         String?           @db.Uuid
  clientId         String            @db.Uuid
  horseId          String?           @db.Uuid
  membershipId     String?           @db.Uuid
  attended         Boolean           @default(false)
  attendanceStatus BookingAttendance @default(PENDING)
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  client           Client            @relation(fields: [clientId], references: [id])
  horse            Horse?            @relation(fields: [horseId], references: [id], onDelete: Restrict)
  membership       Membership?       @relation(fields: [membershipId], references: [id])
  payments         Payment[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  @@index([lessonId])
  @@index([clientId])
  @@index([horseId])
  @@index([membershipId])
  @@index([startTime, endTime])
  @@index([trainerId, status, startTime, endTime])
  @@index([horseId, status, startTime, endTime])
  @@index([arenaId, status, startTime, endTime])
}

model Arena {
  type              ArenaType @default(indoor_arena)
  maxRidersCapacity Int       @default(6)
  isActive          Boolean   @default(true)
  bookings          Booking[]
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  capacity      Int      @default(6)
  isUnavailable Boolean  @default(false)
  lessons       Lesson[]
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

model LedgerTransaction {
  id                   String          @id @default(uuid()) @db.Uuid
  clientId             String          @db.Uuid
  bookingId            String?         @db.Uuid
  membershipId         String?         @db.Uuid
  transactionType      TransactionType
  amount               Decimal         @db.Decimal(14, 2)
  description          String?
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  sourceMembershipOpId String?         @unique @db.Uuid
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  booking              Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  membership           Membership?     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  sourceMembershipOp   MembershipOp?   @relation(fields: [sourceMembershipOpId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([membershipId, createdAt])
  @@index([bookingId, transactionType])
}

model HorseHealthLog {
  id         String        @id @default(uuid()) @db.Uuid
  horseId    String        @db.Uuid
  type       HealthLogType
  occurredAt DateTime      @db.Timestamptz(6)
  nextDueAt  DateTime?     @db.Timestamptz(6)
  notes      String?
  horse      Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(6)

  @@index([horseId, occurredAt])
  @@index([type, nextDueAt])
}

model Stall {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @unique
  description   String?
  isUnavailable Boolean            @default(false)
  contracts     BoardingContract[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
}

model BoardingContract {
  id          String                 @id @default(uuid()) @db.Uuid
  clientId    String?                @db.Uuid
  horseId     String                 @db.Uuid
  stallId     String?                @db.Uuid
  status      BoardingContractStatus @default(DRAFT)
  startsAt    DateTime               @db.Timestamptz(6)
  endsAt      DateTime?              @db.Timestamptz(6)
  monthlyRate Decimal                @default(0) @db.Decimal(12, 2)
  notes       String?
  client      Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  horse       Horse                  @relation(fields: [horseId], references: [id])
  stall       Stall?                 @relation(fields: [stallId], references: [id], onDelete: SetNull)
  payments    Payment[]
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)

  @@index([clientId])
  @@index([horseId, status])
  @@index([stallId, status])
}

model Payment {
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String            @db.Uuid
  bookingId          String?           @db.Uuid
  boardingContractId String?           @db.Uuid
  membershipId       String?           @unique @db.Uuid
  amount             Decimal           @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus     @default(PENDING)
  paidAt             DateTime?         @db.Timestamptz(6)
  description        String?
  client             Client            @relation(fields: [clientId], references: [id])
  booking            Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  boardingContract   BoardingContract? @relation(fields: [boardingContractId], references: [id], onDelete: SetNull)
  membership         Membership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  @@index([clientId, createdAt])
  @@index([bookingId])
  @@index([boardingContractId])
  @@index([status, createdAt])
}

enum BookingAttendance {
  PENDING
  ATTENDED
  NO_SHOW
}

model VkLinkCode {
  id        String   @id @default(uuid()) @db.Uuid
  codeHash  String   @unique
  phone     String
  kind      String
  recordId  String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  usedBy    BigInt?
}

model VkNotification {
  attemptCount Int      @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique
  peerId    BigInt
  message   String
  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  @@index([sentAt, nextAttemptAt])
}

model MembershipOp {
  transaction  LedgerTransaction?
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @db.Uuid
  lessonId     String?          @db.Uuid
  type         MembershipOpType
  amount       Int
  reason       String
  membership   Membership       @relation(fields: [membershipId], references: [id])
  lesson       Lesson?          @relation(fields: [lessonId], references: [id])
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  // PostgreSQL допускает несколько строк с lessonId = NULL, но запрещает
  // повтор одного типа операции для конкретной пары абонемент/занятие.
  @@unique([membershipId, lessonId, type])
  @@index([lessonId])
}

model ClubSchedule {
  id            Int      @id @default(1)
  openTime      String   @default("09:00")
  closeTime     String   @default("21:00")
  daysOfWeekOff Int[]    @default([1])
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}
