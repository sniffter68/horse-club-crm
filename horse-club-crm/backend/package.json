{
  "name": "horse-club-backend",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build",
    "start:dev": "concurrently --kill-others --names types,server \"tsc --watch --preserveWatchOutput\" \"node --env-file=.env --watch dist/main.js\"",
    "test": "tsc --noCheck && node --test test/*.test.cjs",
    "test:unit": "npm run test"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.12",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vk-io": "^4.10.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
