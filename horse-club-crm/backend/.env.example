# Supply a cryptographically random secret of at least 32 bytes through the environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/horse_club_crm?schema=public
CLUB_TIME_ZONE=Europe/Moscow
JWT_SECRET=
PORT=3000
TELEGRAM_BOT_TOKEN=
# Optional trusted Telegram Bot API reverse proxy; leave empty for api.telegram.org.
TELEGRAM_API_ROOT=
TELEGRAM_WEBAPP_URL=https://crm.horseclub68.ru/tma
# Preferred name for the VK community messages token.
VK_GROUP_TOKEN=
# Backward-compatible token names remain supported.
VK_COMMUNITY_TOKEN=
# Legacy fallback when VK_COMMUNITY_TOKEN is empty.
VK_BOT_TOKEN=
VK_CONFIRMATION_CODE=
VK_SECRET_KEY=
VK_GROUP_ID=
VK_ADMIN_PEER_ID=
VK_CLUB_NAME=Союз любителей конного спорта
VK_CLUB_ADDRESS=
VK_CLUB_HOURS=ежедневно с 09:00 до 21:00
VK_CLUB_PHONE=
VK_CLUB_MAP_URL=
# Optional full rider guide; use literal \n for line breaks.
VK_RIDER_GUIDE=
LEAD_CONSENT_VERSION=2026-09-19
PUBLIC_LEADS_ENABLED=false
PUBLIC_LANDING_URL=http://127.0.0.1:5174
ENABLE_MEDICAL_NOTES=false

# Preferred VK Callback API names (legacy names above remain supported).
VK_COMMUNITY_ID=
VK_ACCESS_TOKEN=
VK_CONFIRMATION_TOKEN=
