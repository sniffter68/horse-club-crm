+}
+.landing-shell :is(a, button, summary) { cursor: pointer; }
+.landing-shell :is(a, button)[class*="font-medium"],
+.landing-shell :is(a, button)[class*="font-semibold"] { font-size: 15px; line-height: 20px; }
+.landing-shell :is(button, input, textarea, select):disabled { cursor: not-allowed; }
+
+/* MotionConfig handles JS transforms; reduced motion also removes opacity reveals. */
+@media (prefers-reduced-motion: reduce) {
+  .landing-shell *, .landing-shell *::before, .landing-shell *::after {
+    animation: none !important;
+    transition-duration: 0s !important;
+    scroll-behavior: auto !important;
+  }
+  .landing-shell [style*="opacity"] { opacity: 1 !important; }
 }
 
