diff --git a/horse-club-crm/landing/src/components/ScrollToTop.tsx b/horse-club-crm/landing/src/components/ScrollToTop.tsx
new file mode 100644
index 0000000..570209a
--- /dev/null
+++ b/horse-club-crm/landing/src/components/ScrollToTop.tsx
@@ -0,0 +1,33 @@
+import { useEffect, useState, type ReactElement } from 'react';
+import { ChevronUp } from 'lucide-react';
+
+export function ScrollToTop(): ReactElement {
+  const [visible, setVisible] = useState(false);
+
+  useEffect(() => {
+    const handleScroll = () => setVisible(window.scrollY > 300);
+    handleScroll();
+    window.addEventListener('scroll', handleScroll, { passive: true });
+    return () => window.removeEventListener('scroll', handleScroll);
+  }, []);
+
+  const scrollToTop = () => {
+    window.scrollTo({
+      top: 0,
+      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
+    });
+  };
+
+  return (
+    <button
+      type="button"
+      aria-label="Вернуться наверх"
+      aria-hidden={!visible}
+      disabled={!visible}
+      onClick={scrollToTop}
+      className={`fixed bottom-[calc(6.25rem+env(safe-area-inset-bottom))] right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-club-deep text-club-paper shadow-lg transition-opacity duration-200 hover:bg-club-action active:bg-club-ink focus:outline-none focus:ring-2 focus:ring-club-action focus:ring-offset-2 motion-reduce:transition-none md:right-8 lg:bottom-8 ${visible ? 'cursor-pointer opacity-100' : 'pointer-events-none opacity-0'}`}
+    >
+      <ChevronUp className="h-5 w-5" aria-hidden="true" />
+    </button>
+  );
+}
diff --git a/horse-club-crm/landing/tests/scroll-to-top.spec.ts b/horse-club-crm/landing/tests/scroll-to-top.spec.ts
new file mode 100644
index 0000000..c8e2d10
--- /dev/null
+++ b/horse-club-crm/landing/tests/scroll-to-top.spec.ts
@@ -0,0 +1,34 @@
+import { expect, test } from '@playwright/test';
+
+for (const width of [375, 900, 1440]) {
+  for (const reducedMotion of ['reduce', 'no-preference'] as const) {
+    test(`scroll to top at ${width}px with motion ${reducedMotion}`, async ({ page }) => {
+      await page.setViewportSize({ width, height: 812 });
+      await page.emulateMedia({ reducedMotion });
+      await page.route('**/api/public/content', route => route.fulfill({ json: { horses: [], trainers: [], services: [] } }));
+      await page.goto('/');
+      const button = page.getByRole('button', { name: 'Вернуться наверх', includeHidden: true });
+      await expect(button).toBeDisabled();
+      await expect(button).toHaveCSS('opacity', '0');
+      await page.evaluate(() => window.scrollTo({ top: 300, behavior: 'instant' }));
+      await expect(button).toBeDisabled();
+      await page.evaluate(() => window.scrollTo({ top: 600, behavior: 'instant' }));
+      await expect(button).toBeEnabled();
+      await expect(button).toHaveCSS('opacity', '1');
+      const box = (await button.boundingBox())!;
+      expect(box.width).toBe(48);
+      expect(box.height).toBe(48);
+      expect(box.x + box.width).toBeLessThan(width);
+      if (width < 1024) {
+        const bar = (await page.getByRole('navigation', { name: 'Быстрая запись' }).boundingBox())!;
+        expect(box.y + box.height).toBeLessThan(bar.y);
+      }
+      await button.focus();
+      await expect(button).toBeFocused();
+      await page.keyboard.press('Enter');
+      await expect.poll(() => page.evaluate(() => window.scrollY)).toBe(0);
+      await expect(button).toBeDisabled();
+      await expect(button).toHaveCSS('opacity', '0');
+    });
+  }
+}
