{
	# Explicit HTTP routes below must run before any HTTPS redirect.
	# Certificate provisioning and renewal remain automatic.
	auto_https disable_redirects
}

:80 {
	@vkCallbacks path /api/vk/* /api/vk-bot/*
	handle @vkCallbacks {
		reverse_proxy backend:3000
	}
	handle {
		redir https://{host}{uri} 308
	}
}

(common) {
	encode zstd gzip
	@privateFiles path_regexp privateFiles (?i)(^|/)(\.[^/]+|[^/]+\.(env|sql|dump|bak|log|gz))($|/)
	respond @privateFiles 404
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:3000
	}
}

{$API_SITE} {
	import common
	handle {
		respond "Not Found" 404
	}
}

{$CRM_SITE} {
	import common
	handle {
		root * /var/www/crm-dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

{$LANDING_SITE} {
	import common
	handle {
		root * /var/www/landing-dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
