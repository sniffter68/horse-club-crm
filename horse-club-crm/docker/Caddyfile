{
	# Explicit HTTP routes below must run before any HTTPS redirect.
	# Certificate provisioning and renewal remain automatic.
	auto_https disable_redirects
}

:80 {
	@vkCallbacks path /api/vk/* /api/vk-bot/*
	handle @vkCallbacks {
		reverse_proxy backend:3000
	}
	handle {
		redir https://{host}{uri} 308
	}
}

(common) {
	encode zstd gzip
	@privateFiles path_regexp privateFiles (?i)(^|/)(\.[^/]+|[^/]+\.(env|sql|dump|bak|log|gz))($|/)
	respond @privateFiles 404
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# HTTPS API/CDN photos are allowed; /uploads is also proxied on every site.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'"
	}
	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy backend:3000
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:3000
	}
}

{$API_SITE} {
	import common
	handle {
		respond "Not Found" 404
	}
}

{$CRM_SITE} {
	import common
	@trainerTma path /tma/trainer /tma/trainer/
	handle @trainerTma {
		header -X-Frame-Options
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org; form-action 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'"
		root * /var/www/crm-dist
		rewrite * /index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	@tma path /tma /tma/*
	handle @tma {
		# Telegram Web/Desktop embeds the Mini App. Relax framing only here.
		header -X-Frame-Options
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org; form-action 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'"
		root * /var/www/crm-dist
		rewrite /tma /tma/index.html
		try_files {path} /tma/index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	handle {
		# The shift banner fetches current Tambov weather directly from Open-Meteo.
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com"
		root * /var/www/crm-dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

{$LANDING_SITE} {
	import common
	@vkApp path /vk-app /vk-app/*
	handle @vkApp {
		header -X-Frame-Options
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://vk.com https://*.vk.com https://m.vk.com https://vk.ru https://*.vk.ru https://*.vk-apps.com; form-action 'self'; script-src 'self' https://telegram.org https://unpkg.com https://*.vk.com https://*.vk.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://crm.horseclub68.ru"
		redir /vk-app /vk-app/ 308
		root * /var/www/crm-dist
		uri strip_prefix /vk-app
		try_files /tma{path} /tma/index.html
		header Cache-Control "no-store"
		file_server
	}
	handle {
		# Shares the common CSP and upload proxy with CRM/API.
		root * /var/www/landing-dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
