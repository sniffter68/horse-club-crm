{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-ui-dependencies.cjs",
    "test:e2e:audit": "playwright test --config=playwright.full-crm-audit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:live": "playwright test --config=playwright.crm.config.ts --project=live",
    "test:e2e:mock": "playwright test --config=playwright.crm.config.ts --project=mock",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.playwright.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@refinedev/simple-rest": "^6.0.1",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.76.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "overrides": {
    "path-to-regexp": "8.4.2",
    "decode-uri-component": "0.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@playwright/test": "^1.65.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
